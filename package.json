  "private": true,
  "homepage": "https://bob.fyi",
  "scripts": {
    "dev": "next dev",
    "dev:fresh": "rm -rf .next && next dev",
    "dev:webpack": "next dev --webpack",
    "dev:fresh:webpack": "rm -rf .next && next dev --webpack",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "lint": "eslint --cache --cache-location .next/cache/eslint/",
    "typecheck": "tsc --noEmit --incremental false --pretty false",
    "typecheck:build": "tsc --noEmit --project tsconfig.build.json --incremental false --pretty false",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "analyze:build": "node scripts/analyze-build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "next build && next start",
    "preview:webpack": "next build --webpack && next start"
  },
